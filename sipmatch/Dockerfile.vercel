FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Vercel supplies PORT at runtime and defaults it to 80 for containers.
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-80} --workers 2 --access-logfile - app:app"]
